{
    "name": "hkyss/evocms-fixtures",
    "description": "Generates Evolution CMS content at scale — a document tree with a consistent closure table, template variables, users and permissions — and removes exactly what it made",
    "type": "evolutioncms-package",
    "license": "MIT",
    "keywords": [
        "evolution-cms",
        "evocms",
        "fixtures",
        "seeding",
        "testing",
        "benchmark"
    ],
    "homepage": "https://github.com/hkyss/evocms-fixtures",
    "authors": [
        {
            "name": "hkyss",
            "email": "hkyss.work@protonmail.com",
            "homepage": "https://github.com/hkyss"
        }
    ],
    "support": {
        "issues": "https://github.com/hkyss/evocms-fixtures/issues",
        "source": "https://github.com/hkyss/evocms-fixtures",
        "docs": "https://github.com/hkyss/evocms-fixtures#readme"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6|^10.5"
    },
    "autoload": {
        "psr-4": {
            "hkyss\\Fixtures\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "hkyss\\Fixtures\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "hkyss\\Fixtures\\FixturesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
